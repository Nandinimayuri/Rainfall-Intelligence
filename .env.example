# ==============================================================================
# SIH26080: Rainfall Intelligence Platform - Environment Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=development
APP_NAME="Rainfall Intelligence"
APP_SUBTITLE="Regime-Aware Rainfall Forecast Intelligence Platform"

# Backend Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=True

# Database Configuration (SQLite for local dev, ready for PostgreSQL)
DATABASE_URL=sqlite:///./rainfall_intelligence.db

# Live NWP / Meteorological Data Source API Configuration
# Open-Meteo provides free, legitimate NWP forecast data (ECMWF, GFS, ICON).
# If a private commercial key or IMD API key is used, provide it here.
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
WEATHER_API_KEY=

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# ==============================================================================
# Part 3: AI Assistant / Meteorological Chatbot Configuration
# ==============================================================================
# Any OpenAI-compatible provider (OpenAI, Groq, Together, DeepSeek, Ollama, etc.)
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_PROVIDER=openai
LLM_TIMEOUT_SECONDS=25
